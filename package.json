{
  "name": "@neotales/js-lib",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "description": "Task entry for the js-lib satellite. Bun runs the tasks. The tests do not import node: or process.",
  "scripts": {
    "test": "bun eng/scripts/test-lane.ts bun",
    "test:async": "bun eng/scripts/test-lane.ts async",
    "test:node": "bun eng/scripts/test-lane.ts node",
    "test:deno": "bun eng/scripts/test-lane.ts deno",
    "test:ende": "bun eng/scripts/test-lane.ts ende",
    "test:workerd": "bun eng/scripts/test-lane.ts workerd",
    "test:quickjs": "bun eng/scripts/test-lane.ts quickjs",
    "test:txiki": "bun eng/scripts/test-lane.ts txiki",
    "test:clearscript": "bun eng/scripts/test-lane.ts clearscript",
    "test:jerry": "bun eng/scripts/test-lane.ts jerry",
    "test:chromium": "bun eng/scripts/test-lane.ts chromium",
    "test:firefox": "bun eng/scripts/test-lane.ts firefox",
    "test:webkit": "bun eng/scripts/test-lane.ts webkit",
    "sync:ende": "bun eng/scripts/sync-ende.ts",
    "transpile": "deno run -A --no-lock --node-modules-dir=auto eng/scripts/transpile.ts",
    "test:harness": "bun eng/scripts/test-runner.test.ts",
    "test:types": "deno check --no-lock std/jsr/test/typecheck.ts"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
